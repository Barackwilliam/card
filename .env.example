# Nakili faili hili kuwa ".env" (au weka vigezo hivi kwenye huduma ya hosting).

SECRET_KEY=badilisha-hii-iwe-ndefu-na-ya-siri
DEBUG=0
ALLOWED_HOSTS=michango.example.com
CSRF_TRUSTED_ORIGINS=https://michango.example.com
SITE_URL=https://michango.example.com

# Supabase > Project Settings > Database > Connection string > "Session pooler"
DATABASE_URL=postgresql://postgres.xxxx:NENOSIRI@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase > Storage: tengeneza bucket "kadi" (Public). Kisha Storage > Settings > S3 access keys
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_BUCKET=kadi
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=eu-central-1

# WhatsApp Cloud API (developers.facebook.com > App yako > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=neno-lolote-la-siri-unalochagua
WHATSAPP_TEMPLATE_LANGUAGE=sw

# Siri ya kuanzisha vikumbusho kutoka GitHub Actions / cron-job.org
CRON_SECRET=neno-refu-la-siri
